# ReleaseGuard Environment Configuration Template
# Copy this file to .env and set your secrets before starting the application:
# Copy-Item .env.example .env

# PostgreSQL Database Configuration
POSTGRES_DB=releaseguard
POSTGRES_USER=releaseguard
POSTGRES_PASSWORD=replace_with_a_secure_password_for_local_setup

# Application Container Image Tag (Commit SHA or version for reproducible builds)
IMAGE_TAG=local

# Host Ports
BACKEND_PORT=8080
FRONTEND_PORT=3000
POSTGRES_PORT=5432
